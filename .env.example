# Copie para .env e informe os dados do seu PostgreSQL local.
DATABASE_URL="postgresql://postgres:senha_local@localhost:5432/greencode?schema=public"
# Troque por uma chave aleatória longa antes de executar a API.
JWT_SECRET="troque-esta-chave-por-uma-chave-local-com-mais-de-32-caracteres"
HOST="127.0.0.1"
PORT="3000"
# Opcional: caminho persistente para os arquivos gerados (padrão: data/reports)
REPORTS_DIR=""
# Concorrência do worker PostgreSQL (padrão: 2)
REPORT_WORKER_CONCURRENCY="2"
# Intervalo de consulta da fila em milissegundos (padrão: 1000)
REPORT_WORKER_POLL_MS="1000"
# Tentativas totais por job (padrão: 5)
REPORT_JOB_MAX_ATTEMPTS="5"
# Tempo de lease do worker em milissegundos (padrão: 600000)
REPORT_JOB_LOCK_TIMEOUT_MS="600000"
# Credenciais usadas somente para criar o primeiro administrador.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-segura
